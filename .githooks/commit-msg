#!/usr/bin/env bash
# ==============================================================================
# commit-msg - Conventional Commits check of the commit message
# ==============================================================================
#
# Installed by `tox -e hooks` (git config core.hooksPath .githooks).
#
# Rules (CONVENTIONS.md, Conventional Commits):
#   - subject: type(scope)!: description
#       type        build chore ci docs feat fix perf refactor revert style test
#       (scope)     optional, lower case: letters, digits, . _ / -
#       !           optional, marks a breaking change
#       description starts with a lower-case letter or a backtick, does not
#                   end with a period
#   - a blank line between the subject and the body;
#   - "!" requires a "BREAKING CHANGE: ..." footer;
#   - subject longer than 72 characters: warning; longer than 100: error.
# Merge, revert, fixup!, squash! and amend! messages generated by git are
# accepted as they are.
#
# Bypass for one commit: git commit --no-verify
#
# ==============================================================================

set -euo pipefail

readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

readonly TYPES="build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test"
readonly SUBJECT_RE="^(${TYPES})(\([a-z0-9._/-]+\))?(!)?: [a-z\`](.*[^.])?$"
readonly WARN_LENGTH=72
readonly MAX_LENGTH=100

error()   { echo -e "${RED}[commit-msg] error:${NC} $*" >&2; }
warning() { echo -e "${YELLOW}[commit-msg] warning:${NC} $*" >&2; }

main() {
    local message_file="${1:?usage: commit-msg <message-file>}"

    # The message as git will record it: comment lines and everything below
    # the scissors line (git commit -v) are dropped.
    local lines=()
    local line
    while IFS= read -r line || [[ -n "${line}" ]]; do
        [[ "${line}" == "# ------------------------ >8 ------------------------" ]] && break
        [[ "${line}" == \#* ]] && continue
        lines+=("${line}")
    done < "${message_file}"

    local subject="${lines[0]:-}"
    if [[ -z "${subject//[[:space:]]/}" ]]; then
        error "empty subject line"
        return 1
    fi

    if [[ "${subject}" =~ ^(Merge\ |Revert\ \"|fixup!\ |squash!\ |amend!\ ) ]]; then
        return 0
    fi

    local status=0
    if [[ ! "${subject}" =~ ${SUBJECT_RE} ]]; then
        error "subject does not follow 'type(scope)!: description':"
        echo "    ${subject}" >&2
        echo "    types: ${TYPES//|/, }; lower-case description, no final period" >&2
        status=1
    fi

    local length=${#subject}
    if (( length > MAX_LENGTH )); then
        error "subject is ${length} characters long (maximum ${MAX_LENGTH})"
        status=1
    elif (( length > WARN_LENGTH )); then
        warning "subject is ${length} characters long (aim for ${WARN_LENGTH} at most)"
    fi

    if (( ${#lines[@]} > 1 )) && [[ -n "${lines[1]//[[:space:]]/}" ]]; then
        error "the second line must be blank (subject, blank line, body)"
        status=1
    fi

    if [[ "${subject}" =~ ^[a-z]+(\([^\)]*\))?!: ]]; then
        local footer=false
        for line in "${lines[@]:1}"; do
            if [[ "${line}" =~ ^BREAKING[\ -]CHANGE:\ .+ ]]; then
                footer=true
                break
            fi
        done
        if [[ "${footer}" == false ]]; then
            error "'!' marks a breaking change: add a 'BREAKING CHANGE: ...' footer"
            status=1
        fi
    fi

    if (( status != 0 )); then
        echo "    (git commit --no-verify bypasses this check)" >&2
    fi
    return "${status}"
}

main "$@"
